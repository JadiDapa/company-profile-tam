generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TECHNICIAN
  USER
}

model Media {
  id          Int        @id @default(autoincrement())
  entityId    Int
  url         String
  filename    String?
  mimeType    String?
  size        Int?
  type        String?
  mediaTable  MediaTable
  mediaType   MediaType?
  description String?
  createdAt   DateTime   @default(now())

  @@index([mediaTable, entityId])
  @@index([mediaType])
}

enum MediaTable {
  ACTIVITY
  GALLERY
  TICKET
}

enum MediaType {
  IMAGE
  SUBMISSION
  EVIDENCE
  OTHER
}

model User {
  id       Int      @id @default(autoincrement())
  role     UserRole
  username String   @unique
  fullName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model Activity {
  id        Int      @id @default(autoincrement())
  title     String
  category  String
  content   String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Gallery {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
